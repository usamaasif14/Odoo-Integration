<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_invoice_document_inherit_l10n_uy_edi" inherit_id="account.report_invoice_document">

        <div class="row" position="after">
            <t t-if="o.l10n_uy_edi_journal_type in ['electronic', 'contingency']">
                <div class="watermark" style="position:absolute;opacity:0.25;font-size:3em;color:red;width:100%;text-align:center;z-index:1000;">NOT LEGAL DOCUMENT</div>
            </t>
        </div>

        <div class="row" position="before">
            <t t-set="l10n_uy_edi_vat_label" t-value="o.l10n_uy_edi_journal_type in ('electronic', 'contingency') and o.partner_id.l10n_latam_identification_type_id.country_id and o.partner_id.l10n_latam_identification_type_id.name"/>
        </div>

        <xpath expr="//div[@id='partner_vat_address_not_same_as_shipping']//t[@id='inv_tax_id_label']" position="attributes">
            <attribute name="t-if">l10n_uy_edi_vat_label or o.company_id.account_fiscal_country_id.vat_label</attribute>
            <attribute name="t-out">l10n_uy_edi_vat_label or o.company_id.account_fiscal_country_id.vat_label</attribute>
        </xpath>

        <xpath expr="//div[@id='partner_vat_address_same_as_shipping']//t[@id='inv_tax_id_label']" position="attributes">
            <attribute name="t-if">l10n_uy_edi_vat_label or o.company_id.account_fiscal_country_id.vat_label</attribute>
            <attribute name="t-out">l10n_uy_edi_vat_label or o.company_id.account_fiscal_country_id.vat_label</attribute>
        </xpath>

        <xpath expr="//div[@id='partner_vat_no_shipping']//t[@id='inv_tax_id_label']" position="attributes">
            <attribute name="t-if">l10n_uy_edi_vat_label or o.company_id.account_fiscal_country_id.vat_label</attribute>
            <attribute name="t-out">l10n_uy_edi_vat_label or o.company_id.account_fiscal_country_id.vat_label</attribute>
        </xpath>
    </template>

</odoo>
