#. module: sale_tiktok
#: model:mail.template,body_html:sale_tiktok.order_sync_failure
msgid ""
"<div>\n"
"                <p>\n"
"                    The synchronization of the TikTok Shop order with reference\n"
"                    <t t-out=\"ctx.get('tiktok_order_ref') or ''\">REF</t>\n"
"                    encountered an error and was not completed.\n"
"                </p>\n"
"                <p>\n"
"                    Unless the order is canceled in TikTok Shop, no other synchronization will be attempted.\n"
"                </p>\n"
"                <p>\n"
"                    To schedule a new synchronization attempt, proceed as follows:\n"
"                    </p><ol>\n"
"                        <li>Enter the Developer Tools.</li>\n"
"                        <li>Open the form of the TikTok Shop on which the order was placed.</li>\n"
"                        <li>Navigate to the Order Follow-up tab.</li>\n"
"                        <li>\n"
"                            Set a date for <em>Last Order Synchronization Date</em> that is before the last status update of the order.\n"
"                        </li>\n"
"                        <li>Save the changes and click on the <em>SYNC ORDERS</em> button.</li>\n"
"                    </ol>\n"
"                \n"
"                <p>\n"
"                    If the problem persists, contact\n"
"                    <a href=\"https://www.odoo.com/help/\">Odoo support</a>.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>\n"
"                    Sinhronizacija naročila TikTok Shop z referenco\n"
"                    <t t-out=\"ctx.get('tiktok_order_ref') or ''\">REF</t>\n"
"                    je naletela na napako in ni bila dokončana.\n"
"                </p>\n"
"                <p>\n"
"                    Če naročilo ni preklicano v TikTok Shopu, nobena druga "
"sinhronizacija ne bo izvedena.\n"
"                </p>\n"
"                <p>\n"
"                    Za načrtovanje novega poskusa sinhronizacije postopajte "
"tako:\n"
"                    </p><ol>\n"
"                        <li>Odprite razvojna orodja.</li>\n"
"                        <li>Odprite obrazec trgovine TikTok Shop, v kateri "
"je bilo naročilo oddano.</li>\n"
"                        <li>Pomaknite se na zavihek Nadaljnje spremljanje "
"naročil.</li>\n"
"                        <li>\n"
"                            Nastavite datum za <em>Datum zadnje "
"sinhronizacije naročil</em>, ki je pred zadnjo posodobitvijo statusa "
"naročila.\n"
"                        </li>\n"
"                        <li>Shranite spremembe in kliknite gumb <em>"
"SINHRONIZIRAJ NAROČILA</em>.</li>\n"
"                    </ol>\n"
"                \n"
"                <p>\n"
"                    Če težava ni odpravljena, se obrnite na\n"
"                    <a href=\"https://www.odoo.com/help/\">Odoo podporo</a>"
".\n"
"                </p>\n"
"            </div>\n"
"        "

#. module: sale_tiktok
#: model_terms:ir.ui.view,arch_db:sale_tiktok.tiktok_shop_form
msgid ""
"<strong>Authorization Failed: </strong>\n"
"                    An unexpected error occurred during authorization. Please try again."
msgstr ""
"<strong>Avtorizacija ni uspela: </strong>\n"
"                    Med avtorizacijo je prišlo do nepričakovane napake. "
"Poskusite znova."

#. module: sale_tiktok
#: model_terms:ir.ui.view,arch_db:sale_tiktok.tiktok_shop_create_wizard_view_form
msgid ""
"<strong>Where to find your API credentials:</strong><br/>\n"
"                    1. Go to TikTok Shop Partner Center<br/>\n"
"                    2. Navigate to Apps &amp; Service → Create New App or use existing<br/>\n"
"                    3. Grant the App permissions to access your shop data<br/>\n"
"                    4. Get your Service ID, App key and App secret<br/>"
msgstr ""
"<strong>Kje najdete poverilnice API-ja:</strong><br/>\n"
"                    1. Pojdite v TikTok Shop Partner Center<br/>\n"
"                    2. Pomaknite se do Apps &amp; Service → Create New App "
"ali uporabite obstoječo<br/>\n"
"                    3. Aplikaciji dodelite dovoljenja za dostop do podatkov "
"vaše trgovine<br/>\n"
"                    4. Pridobite svoj ID storitve, ključ aplikacije in "
"skrivnost aplikacije<br/>"

#. module: sale_tiktok
#: model:mail.template,body_html:sale_tiktok.inventory_sync_failure
msgid ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    The synchronization of the inventory for TikTok Shop\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></b>\n"
"                    encountered some errors and was not completed.\n"
"                </p>\n"
"                <p>Here are the errors sent by TikTok Shop:</p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Product Internal Reference(s)</th>\n"
"                            <th>Message</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])\"/>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-out=\"error['message']\"/>\n"
"                                <t t-else=\"\">\n"
"                                    An unknown error occurred during the synchronisation with TikTok Shop.\n"
"                                    Unfortunately you need to manually check if the available quantity for the product is correct or not.\n"
"                                    If the problem persists, contact\n"
"                                    <a href=\"https://www.odoo.com/help/\">Odoo support</a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"
msgstr ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    Sinhronizacija zaloge za trgovino TikTok Shop\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></b>"
"\n"
"                    je naletela na nekaj napak in ni bila dokončana.\n"
"                </p>\n"
"                <p>Tukaj so napake, ki jih je poslala trgovina TikTok Shop:</"
"p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Interna referenca izdelka</th>\n"
"                            <th>Sporočilo</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])"
"\"/>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"/>\n"
"                                <t t-else=\"\">\n"
"                                    Med sinhronizacijo s trgovino TikTok "
"Shop je prišlo do neznane napake.\n"
"                                    Žal morate ročno preveriti, ali je "
"razpoložljiva količina izdelka pravilna ali ne.\n"
"                                    Če težava ni odpravljena, se obrnite na\n"
"                                    <a href=\"https://www.odoo.com/help/\">"
"Odoo podporo</a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"

